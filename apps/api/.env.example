# Copy to apps/api/.env for local development. Every value is optional locally:
# with no MONGODB_URI the API starts an in-memory MongoDB and seeds it on boot.

# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lams?retryWrites=true&w=majority
# JWT_ACCESS_SECRET=<at least 32 random characters; required in production>
# PORT=4000
# LOG_LEVEL=info

# Demo logins for judges (one per role, all with this password).
DEMO_MODE=true
DEMO_USER_PASSWORD=Demo@Lams2026

# CORS_ORIGINS=https://your-app.vercel.app
# TRUST_PROXY=0
